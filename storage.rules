rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // โลโก้ต้องอ่านได้สาธารณะเพื่อให้ overlay.html โหลดรูปแสดงผลได้
    // เขียนได้เฉพาะไฟล์ในโฟลเดอร์ logos/ เท่านั้น จำกัดชนิดไฟล์เป็นรูปภาพ และขนาดไม่เกิน 5MB
    match /logos/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
